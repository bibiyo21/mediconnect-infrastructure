# Copy to .env for docker compose. LOCAL values only; never reuse in any shared environment.
POSTGRES_SUPERUSER_PASSWORD=change-me-local
DB_DATABASE=mediconnect
DB_OWNER_USER=mediconnect_owner
DB_OWNER_PASSWORD=change-me-local-owner
DB_APP_USER=mediconnect_app
DB_APP_PASSWORD=change-me-local-app
TYPESENSE_API_KEY=local-dev-key
HOST_UID=1000
HOST_GID=1000
# Path to the mediconnect-backend checkout (default: ../backend)
BACKEND_PATH=../backend
