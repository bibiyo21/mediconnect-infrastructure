# Copy to .env for docker compose. LOCAL values only; never reuse in any shared environment.
POSTGRES_SUPERUSER_PASSWORD=change-me-local
DB_DATABASE=mediconnect
DB_OWNER_USER=mediconnect_owner
DB_OWNER_PASSWORD=change-me-local-owner
DB_APP_USER=mediconnect_app
DB_APP_PASSWORD=change-me-local-app
TYPESENSE_API_KEY=change-me-local-typesense
HOST_UID=1000
HOST_GID=1000
# Path to the mediconnect-backend checkout (default: ../backend)
BACKEND_PATH=../backend
# Folder that contains the mediconnect-docs docs/ folder (default: ..)
DOCS_PATH=..
# Private object storage (SeaweedFS, S3-compatible; D-36). Generate a long random secret locally
# and put the same values in backend/.env as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_ACCESS_KEY=mediconnect
S3_SECRET_KEY=change-me-local-s3
S3_BUCKET=mediconnect-private
